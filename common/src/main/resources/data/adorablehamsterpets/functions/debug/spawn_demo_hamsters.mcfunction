# Spawn 11 hamsters used for update showcase videos

# Abraham Lincoln (WHITE)
ahp spawn hamster white none none none none black
data merge entity @e[type=adorablehamsterpets:hamster,distance=..3,tag=!temp_data_tag,limit=1,sort=nearest] {CustomName:'{"text":"Abraham Lincoln"}', NoAI:0b, NoGravity:0b, Sitting:0b}
data modify entity @e[type=adorablehamsterpets:hamster,distance=..3,tag=!temp_data_tag,limit=1,sort=nearest] Owner set from entity @s UUID
tag @e[type=adorablehamsterpets:hamster,distance=..3,tag=!temp_data_tag,limit=1,sort=nearest] add temp_data_tag

